---
import { team, placeOf } from '../lib/strat.mjs';
import { nth, gbStr } from '../lib/fmt.mjs';
const { ab, tab } = Astro.props;
const t = team(ab); const p = placeOf(ab); const base = `/teams/${ab.toLowerCase()}/`;
const tabs = [['', 'Overview'], ['roster/', 'Roster'], ['stats/', 'Stats'], ['schedule/', 'Schedule']];
---
<div class="teamhead">
  {t.logo && <img src={t.logo} alt={`${t.city} ${t.nickname} logo`} />}
  <div>
    <h1>{t.city} {t.nickname}</h1>
    <div class="sub">{nth(p.place)} in the {t.confName} {t.divLabel}{p.gb ? `, ${gbStr(p.gb)} games back` : ', division leader'}</div>
    <dl class="kv"><dt>Owner</dt><dd>{t.owner || 'Vacant'}</dd><dt>Manager</dt><dd>{t.manager || 'Vacant'}</dd></dl>
  </div>
  <div class="rec">{t.w}-{t.l}<small>{(t.pct).toFixed(3).replace(/^0/, '')} winning pct.</small></div>
</div>
<nav class="tabs">{tabs.map(([href, label]) => <a href={base + href} class={tab === label ? 'on' : ''}>{label}</a>)}</nav>
