---
import Base from '../../layouts/Base.astro';
import { newspaper, newspaperDates, storyHeadline } from '../../lib/strat.mjs';
import { fmtDate } from '../../lib/fmt.mjs';
export function getStaticPaths() { return newspaperDates().map((date) => ({ params: { date } })); }
const { date } = Astro.params;
const all = newspaperDates(); const i = all.indexOf(date);
const P = newspaper(date);
const stories = P.stories; const box = P.blocks.filter((b) => b.kind === 'box');
const report = P.blocks.filter((b) => ['recap', 'standings', 'other'].includes(b.kind));
---
<Base title={`Daily News, ${fmtDate(date)}`} active="newspaper">
  <div class="datebar">
    <span class="d">{fmtDate(date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</span>
    {i > 0 && <a class="btn sm" href={`/newspaper/${all[i - 1]}/`}>Previous day</a>}
    {i < all.length - 1 && <a class="btn sm" href={`/newspaper/${all[i + 1]}/`}>Next day</a>}
    <input type="date" id="pick" value={date} min={all[0]} max={all.at(-1)} aria-label="Go to date" />
    <span class="muted small" id="pickmsg"></span>
  </div>
  <nav class="tabs noprint"><a href="#stories" class="on">Game stories ({stories.length})</a><a href="#box">Box scores ({box.length})</a><a href="#league">League report</a></nav>

  <section id="stories" class="storygrid">{stories.map((s) => (
    <article class="story" id={s.id}>
      <h3>{storyHeadline(s)}</h3>
      <pre class="mono">{s.linescore}</pre>
      {s.paragraphs.map((p) => <p>{p}</p>)}
      {P.blocks.some((b) => b.id === `box-${s.id}`) && <p class="small" style="font-family:var(--sans)"><a href={`#box-${s.id}`}>Box score</a></p>}
    </article>))}
  </section>
  <section id="box"><h2 class="major">Box scores</h2><div class="paper">{box.map((b) => <pre id={b.id} set:html={b.html} />)}</div></section>
  <section id="league"><h2 class="major">League report</h2><div class="paper">{report.map((b) => <pre set:html={b.html} />)}</div></section>
  <script is:inline>
    const pick = document.getElementById('pick');
    pick.addEventListener('change', async () => {
      const dates = await (await fetch('/data/papers.json')).json();
      const d = pick.value; const hit = dates.includes(d) ? d : dates.find((x) => x >= d);
      if (hit) location.href = `/newspaper/${hit}/`; else document.getElementById('pickmsg').textContent = 'No newspaper on or after that date.';
    });
  </script>
</Base>
