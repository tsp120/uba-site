---
import Base from '../layouts/Base.astro';
import TeamLink from '../components/TeamLink.astro';
import Score from '../components/Score.astro';
import Logo from '../components/Logo.astro';
import { newspaper, newspaperDates, storyHeadline, posts, standings, teamList, team, schedule, lastPlayedDate } from '../lib/strat.mjs';
import { fmtDate, paperUrl, gbStr } from '../lib/fmt.mjs';
const dates = newspaperDates().slice(-3).reverse();
const stories = dates.flatMap((d) => newspaper(d).stories.map((s) => ({ ...s, href: `${paperUrl(d)}#${s.id}`, title: storyHeadline(s) })));
const featured = stories[0];
const rest = stories.slice(1, 11);
const news = posts().slice(0, 5);
const C = standings();
const last = lastPlayedDate();
const finals = schedule().games.filter((g) => g.date === last && g.played);
// Inning-by-inning line from the Strat story ("Jacks........... 4 3 0  0 0 3  0 1 0  - 11 14  0").
const lines = featured ? featured.linescore.split('\n').map((l) => l.match(/^\S.*?\.+\s+((?:[\dXx]+\s+)+)-\s+(\d+)\s+(\d+)\s+(\d+)\s*$/)).filter(Boolean).slice(0, 2).map((m) => ({ inn: m[1].trim().split(/\s+/), r: +m[2], h: m[3], e: m[4] })) : [];
const innings = Math.max(0, ...lines.map((l) => l.inn.length));
const decision = featured?.decision.replace(/Win:/, 'W: ').replace(/Loss:/, ', L: ').replace(/Save:/, ', S: ').replace(/\s+,/g, ',');
---
<Base title="" active="home">
  {news.length > 0 && (
  <section class="newsband" aria-roledescription="carousel" aria-label="League news">
    <div class="nb-slides">
      {news.map((p, k) => (
      <article class="nb-slide" id={`nb${k}`} aria-roledescription="slide" aria-label={`${k + 1} of ${news.length}`} hidden={k > 0}>
        <div class="nb-text">
          <p class="when">{p.date ? fmtDate(p.date, { weekday: 'long', month: 'long', day: 'numeric' }) : 'League news'}</p>
          <h1><a href={`/news/${p.slug}/`}>{p.title}</a></h1>
          <p>{p.excerpt}{p.excerpt.length >= 200 ? '…' : ''}</p>
          <a class="btn fill" href={`/news/${p.slug}/`}>Read the story</a>
        </div>
        <a class="nb-photo" href={`/news/${p.slug}/`} tabindex="-1" aria-hidden="true">
          {p.image ? <img src={p.image} alt="" loading={k ? 'lazy' : 'eager'} /> : <span class="nb-nophoto"><Logo size={150} /></span>}
        </a>
      </article>))}
    </div>
    {news.length > 1 && (
    <div class="nb-ctrl">
      <button type="button" class="nb-arrow" data-nb="prev" aria-label="Previous story">‹</button>
      {news.map((p, k) => <button type="button" class="nb-dot" data-nb-go={k} aria-label={`Story ${k + 1}: ${p.title}`} aria-current={k === 0 ? 'true' : 'false'}></button>)}
      <button type="button" class="nb-arrow" data-nb="next" aria-label="Next story">›</button>
      <button type="button" class="nb-pause" data-nb="pause">Pause</button>
      <a class="nb-all" href="/news/">All news</a>
    </div>)}
  </section>)}

  {featured && (
  <section class={news.length ? 'gotd' : 'hero'}>
    <div>
      <p class="when">Game of the day, {fmtDate(featured.date, { weekday: 'long', month: 'long', day: 'numeric' })}</p>
      {news.length ? <h2>{featured.title}</h2> : <h1>{featured.title}</h1>}
      {featured.paragraphs.slice(0, 2).map((p) => <p>{p}</p>)}
      <a class="btn fill" href={featured.href}>Read the full story</a>
    </div>
    {lines.length === 2 && (
    <div class="linecard" aria-label="Line score">
      <div class="bar"></div>
      <div class="body">
        <table>
          <thead><tr><th></th>{Array.from({ length: innings }, (_, i) => <th class="inn">{i + 1}</th>)}<th>R</th><th>H</th><th>E</th></tr></thead>
          <tbody>{[[featured.away, lines[0]], [featured.home, lines[1]]].map(([ab, l]) => (
            <tr class={l.r === Math.max(lines[0].r, lines[1].r) ? 'won' : ''}>
              <td class="tm">{team(ab)?.logo && <img class="logo-sm" src={team(ab).logo} alt="" />}{team(ab)?.city || ab}</td>
              {Array.from({ length: innings }, (_, i) => <td class="inn">{l.inn[i] ?? ''}</td>)}<td class="tot">{l.r}</td><td class="tot">{l.h}</td><td class="tot">{l.e}</td>
            </tr>))}</tbody>
        </table>
        {decision && <p class="dec">{decision}</p>}
      </div>
    </div>)}
  </section>)}

  <section>
    <h2 class="major">Final scores<small>{fmtDate(last, { weekday: 'long', month: 'long', day: 'numeric' })}</small></h2>
    <div class="scores">{finals.map((g) => <Score g={g} />)}</div>
  </section>

  <div class="home-cols">
    <section>
      <h2 class="major">Around the league</h2>
      <div class="posts">{rest.map((s) => <article class="post"><div class="meta">{fmtDate(s.date, { month: 'short', day: 'numeric' })}</div><h3><a href={s.href}>{s.title}</a></h3><p>{s.lead}</p></article>)}</div>
      <p style="margin-top:1.2rem"><a class="btn" href={paperUrl(dates[0])}>Open today's newspaper</a></p>
    </section>
    <aside class="side-standings">
      <h2 class="major">Standings</h2>
      {C.map((c) => <>
        <div class="conf">{c.name}</div>
        <div class="tscroll"><table><thead><tr><th>Team</th><th class="num">W</th><th class="num">L</th><th class="num">GB</th></tr></thead>
          <tbody>{c.divisions.map((d) => <><tr class="dv"><td colspan="4">{d.label}</td></tr>{d.rows.slice(0, 2).map((r, i) => <tr class={i === 0 ? 'lead-row' : ''}><td><TeamLink ab={r.abbr} /></td><td class="num">{r.w}</td><td class="num">{r.l}</td><td class="num">{gbStr(r.gb)}</td></tr>)}</>)}</tbody></table></div>
      </>)}
      <p class="small"><a href="/standings/">Full standings and wild card</a></p>
    </aside>
  </div>

  <section>
    <h2 class="major">The 30 clubs</h2>
    <div class="teamrail">{teamList().map((t) => <a href={`/teams/${t.abbr.toLowerCase()}/`}>{t.logo && <img src={t.logo} alt="" loading="lazy" />}<span>{t.city}</span></a>)}</div>
  </section>
  <script is:inline>
    (() => {
      // News band: moves to the next story every 8 seconds until someone presses Pause.
      // It keeps going while the mouse is over it; it only waits while the browser tab is in the background.
      const band = document.querySelector('.newsband'); if (!band) return;
      const slides = [...band.querySelectorAll('.nb-slide')], dots = [...band.querySelectorAll('.nb-dot')]; if (slides.length < 2) return;
      const pauseBtn = band.querySelector('[data-nb="pause"]');
      let cur = 0, timer = null, stopped = false;
      const go = (n) => { cur = (n + slides.length) % slides.length; slides.forEach((s, k) => { s.hidden = k !== cur; }); dots.forEach((d, k) => d.setAttribute('aria-current', String(k === cur))); };
      const arm = () => { clearTimeout(timer); if (!stopped && !document.hidden) timer = setTimeout(() => { go(cur + 1); arm(); }, 8000); };
      const setStopped = (v) => { stopped = v; pauseBtn.textContent = v ? 'Play' : 'Pause'; pauseBtn.setAttribute('aria-label', v ? 'Rotate stories' : 'Stop rotating stories'); arm(); };
      band.querySelector('[data-nb="prev"]').onclick = () => { go(cur - 1); arm(); };
      band.querySelector('[data-nb="next"]').onclick = () => { go(cur + 1); arm(); };
      dots.forEach((d) => (d.onclick = () => { go(+d.dataset.nbGo); arm(); }));
      pauseBtn.onclick = () => setStopped(!stopped);
      document.addEventListener('visibilitychange', arm);
      setStopped(false);
    })();
  </script>
</Base>
