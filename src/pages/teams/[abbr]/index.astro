---
import Base from '../../../layouts/Base.astro';
import TeamHeader from '../../../components/TeamHeader.astro';
import Score from '../../../components/Score.astro';
import { teamList, team, teamSchedule, newspaper, newspaperDates, storyHeadline, teamPlayers, league } from '../../../lib/strat.mjs';
import { fmtDate, paperUrl } from '../../../lib/fmt.mjs';
export function getStaticPaths() { return teamList().map((t) => ({ params: { abbr: t.abbr.toLowerCase() } })); }
const ab = Astro.params.abbr.toUpperCase(); const t = team(ab);
const sched = teamSchedule(ab); const played = sched.filter((g) => g.played); const next = sched.filter((g) => !g.played).slice(0, 5);
const yr = String(league().season);
const stories = newspaperDates().filter((d) => d.startsWith(yr)).reverse().flatMap((d) => newspaper(d).stories.filter((s) => s.away === ab || s.home === ab)).slice(0, 9);
const P = teamPlayers(ab);
const topB = [...P.batters].sort((a, b) => +b.hr - +a.hr).slice(0, 3); const topP = [...P.pitchers].sort((a, b) => +b.w - +a.w).slice(0, 3);
---
<Base title={`${t.city} ${t.nickname}`} active="teams">
  <TeamHeader ab={ab} tab="Overview" />
  <div class="grid g2">
    <section><h2 class="major">Last five games</h2><div class="scores">{played.slice(-5).reverse().map((g) => <Score g={g} />)}</div>
      {next.length > 0 && <><h3 style="margin-top:1.2rem">Up next</h3><div class="scores">{next.map((g) => <Score g={g} />)}</div></>}</section>
    <section><h2 class="major">Team leaders</h2>
      <table><tbody>
        {topB.map((p) => <tr><td>{p.name}</td><td class="num">{p.avg}</td><td class="num">{p.hr} HR</td><td class="num">{p.rbi} RBI</td></tr>)}
        {topP.map((p) => <tr><td>{p.name}</td><td class="num">{p.w}-{p.l}</td><td class="num">{p.era} ERA</td><td class="num">{p.so} K</td></tr>)}
      </tbody></table></section>
  </div>
  <section><h2 class="major">Team news</h2>
    <div class="posts">{stories.map((s) => <article class="post"><div class="meta">{fmtDate(s.date)}</div><h3><a href={`${paperUrl(s.date)}#${s.id}`}>{storyHeadline(s)}</a></h3><p>{s.lead}</p></article>)}</div></section>
</Base>
