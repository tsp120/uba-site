---
import '@fontsource/alfa-slab-one/400.css';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/700.css';
import Logo from '../components/Logo.astro';
import '../styles.css';
import { league, standings, schedule, lastPlayedDate, team, newspaperDates, currentScheduleDate } from '../lib/strat.mjs';
import { fmtDate, paperUrl } from '../lib/fmt.mjs';
const { title, active = '', spoilerFree = false } = Astro.props;
const L = league();
// Link straight to the dated pages so nobody ever sees a redirect.
const nav = [['/', 'Home', 'home'], ['/watch/', 'Watch', 'watch'], [`/newspaper/${newspaperDates().at(-1)}/`, 'Daily News', 'newspaper'], [`/schedule/${currentScheduleDate()}/`, 'Schedule', 'schedule'], ['/standings/', 'Standings', 'standings'], ['/stats/', 'Stats', 'stats'], ['/teams/', 'Teams', 'teams'], ['/trade/', 'Trades', 'trade'], ['/files/', 'Files', 'files'], ['/news/', 'News', 'news']];
const leaders = standings().flatMap((c) => c.divisions.map((d) => ({ div: `${c.name.replace(' Conference', '')} ${d.label}`, t: d.rows[0] })));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} | UBA` : 'Unbelievable Baseball Association'}</title>
  <meta name="description" content="The Unbelievable Baseball Association, a 30-team Strat-O-Matic league since 1968." />
  <meta name="theme-color" content="#1C2340" />
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class="mast">
    <div class="mast-in">
      <a href="/" class="brand"><Logo size={54} /><div><b>Unbelievable Baseball Association</b><span>Strat-O-Matic since {L.established}</span></div></a>
      <button type="button" class="navbtn" id="navbtn" aria-label="Open menu" aria-expanded="false" aria-controls="mainnav"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span><span class="lbl">Menu</span></button>
      <nav aria-label="Main" id="mainnav">{nav.map(([href, label, key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}</nav>
    </div>
  </header>
  <div class="stripe" role="presentation"></div>
  <main class="page"><slot /></main>
  <footer class="foot">
    <div class="foot-in">
      <Logo size={88} />
      {spoilerFree ? <div><h4>No spoilers here</h4><p>Standings and scores are hidden on Watch pages so you can follow games without knowing how they ended.</p></div> : <div>
        <h4>Division leaders</h4>
        <table><tbody>{leaders.map(({ div, t }) => <tr><td>{div}</td><td><a href={`/teams/${t.abbr.toLowerCase()}/`}>{t.city} {t.nickname}</a></td><td class="num">{t.w}-{t.l}</td></tr>)}</tbody></table>
      </div>}
      <div>
        <h4>The UBA</h4>
        <p>Thirty managers, one Strat-O-Matic league, every season since {L.established}. The commissioner runs the league; this site shows what he publishes.</p>
        <p><a href="https://www.facebook.com/search/top?q=the%20uba%20(the%20unbelievable%20baseball%20association)">UBA on Facebook</a><br /><a href="/admin/">Commissioner login</a></p>
      </div>
    </div>
  </footer>
  <script is:inline src="/site.js"></script>
</body>
</html>
